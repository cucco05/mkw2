DATABASE_URL="postgresql://postgres:postgres@db:5432/makerworks?schema=public"
# Optional (local runtime): explicit PostgreSQL client tool paths for backup/restore.
# Example Windows:
# PG_DUMP_BIN="C:\Program Files\PostgreSQL\16\bin\pg_dump.exe"
# PSQL_BIN="C:\Program Files\PostgreSQL\16\bin\psql.exe"
# Backup scheduling and retention (UTC):
# Runtime mode:
# - Unraid / non-compose container: SKIP_DOCKER="1", PG_DUMP_BIN="/usr/bin/pg_dump", PSQL_BIN="/usr/bin/psql"
# - Docker Compose: SKIP_DOCKER="0" (or omit), BACKUP_DOCKER_SERVICE="db" (or your DB service name)
# Backup destination path (optional): BACKUP_DIR="/app/backups" (recommended dedicated mapped path)
# SKIP_DOCKER="0"
# PG_DUMP_BIN="/usr/bin/pg_dump"
# PSQL_BIN="/usr/bin/psql"
# BACKUP_DOCKER_SERVICE="db"
# BACKUP_SCHEDULE_ENABLED="0"
# BACKUP_SCHEDULE_TIME_UTC="03:00"
# BACKUP_RUN_ON_START="0"
# BACKUP_PRUNE_ON_BACKUP="1"
# BACKUP_RETENTION_DAYS="14"
# BACKUP_RETENTION_MAX_COUNT="30"
JWT_SECRET="replace-with-a-strong-secret"
BASE_URL="http://localhost:3000"
STORAGE_DIR="/app/storage"
# Files are always served by the app at /files (access-controlled). CDN base URLs (FILES_BASE_URL) are no longer supported.
# Recommended: keep database backups OUTSIDE STORAGE_DIR, e.g. BACKUP_DIR="/app/backups".
# Optional: point uploads to a direct hostname (bypasses Cloudflare/Tunnel limits)
# DIRECT_UPLOAD_URL="https://upload.example.com"
# Optional: LAN-only direct upload hostname. Used automatically when the request comes from a LAN hostname.
# Example:
# LAN_DIRECT_UPLOAD_URL="http://makerworks-nas:3000"
# LAN_SITE_HOSTS="makerworks.local,192.168.1.50,https://makerworks.local"
# Optional: LAN-only upload size caps in bytes. Set to "0" for no app-enforced limit on LAN uploads.
# LAN_UPLOAD_MAX_FILE_BYTES="0"
# LAN_UPLOAD_MAX_TOTAL_BYTES="0"
# Optional: bulk importer defaults
# BULK_UPLOAD_DIR="/app/imports/models"
# BULK_UPLOAD_BASE_URL="http://127.0.0.1:3000"
# BULK_UPLOAD_EMAIL="admin@example.com"
# BULK_UPLOAD_PASSWORD="replace-me"
# BULK_UPLOAD_MATERIAL="PLA"
# BULK_UPLOAD_TAGS=""
# BULK_UPLOAD_DESCRIPTION=""
# BULK_UPLOAD_CREDIT_NAME=""
# BULK_UPLOAD_CREDIT_URL=""
# BULK_UPLOAD_LIMIT=""
# BULK_UPLOAD_DRY_RUN="0"
# BULK_UPLOAD_MATCH_COVER="1"
# Optional: upload limits in bytes
# UPLOAD_MAX_FILE_BYTES="209715200"
# UPLOAD_MAX_TOTAL_BYTES="314572800"
# UPLOAD_MAX_3MF_CONVERT_BYTES="26214400"
# UPLOAD_MAX_3MF_TRIANGLES="1200000"
# Options: BAMBU_X1C, BAMBU_P1S, PRUSA_MK4, PRUSA_MK3S, CREALITY_K1_MAX, CREALITY_ENDER3_V2, ANYCUBIC_KOBRA2, GENERIC_FDM
PRINTER_PROFILE="BAMBU_X1C"
# Override if your electricity rate differs from the ~$0.14/kWh default.
# PRINTER_ELECTRIC_RATE_PER_KWH="0.14"
PLA_PRICE_PER_KG_USD="25.00"
PETG_PRICE_PER_KG_USD="28.00"
NEXT_PUBLIC_PLA_PRICE_PER_KG="25.00"
NEXT_PUBLIC_PETG_PRICE_PER_KG="28.00"
COLOR_SURCHARGE_RATE="0.05"
NEXT_PUBLIC_COLOR_SURCHARGE_RATE="0.05"
NEXT_PUBLIC_MAX_CART_COLORS="4"
SUPPORT_OVERHANG_ANGLE_DEG="45"
SUPPORT_VOLUME_MULTIPLIER_MAX="0.6"
COLOR_TIME_MULTIPLIER_PER_COLOR="0.2"
# Optional: per-finish surcharge map (decimal percent).
# Example: {"standard":0,"matte":0.05,"gloss":0.1}
# FINISH_SURCHARGES=""
# NEXT_PUBLIC_FINISH_SURCHARGES=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Optional: Stripe webhook signing secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
# Optional: Stripe shipping rate id for flat-rate shipping
STRIPE_SHIPPING_RATE_ID=""
# Optional: PayPal checkout. PAYPAL_CLIENT_ID is public through /api/public-config; keep PAYPAL_CLIENT_SECRET private.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Options: sandbox or live
PAYPAL_ENVIRONMENT="sandbox"
# Optional: Sentry DSN for API + client error forwarding
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Optional: MakerWorks inbound secret used by external processors
MAKERWORKS_INBOUND_SECRET=""
# Optional: dedicated processing queue broker (BullMQ)
REDIS_URL=""
# Optional worker tuning
# IMAGE_WORKER_CONCURRENCY="2"
# PREVIEW_WORKER_CONCURRENCY="1"
# PROCESSING_QUEUE_ATTEMPTS="5"
# PROCESSING_QUEUE_BACKOFF_MS="5000"
# Optional legacy override. In-app suite setup is preferred.
# StockWorks inventory integration for filament availability.
STOCKWORKS_BASE_URL="http://host.docker.internal:8000"
STOCKWORKS_ADMIN_USERNAME="admin"
STOCKWORKS_ADMIN_PASSWORD="changeme"
# Optional legacy override. In-app suite setup is preferred.
# PrintLab integration for printer status/queue.
# PRINTLAB_BASE_URL="http://host.docker.internal:8289"
# Optional machine auth key if your PrintLab server is configured with an API key
# PRINTLAB_API_KEY=""
# Optional API key header name (defaults to X-API-Key)
# PRINTLAB_API_KEY_HEADER="X-API-Key"
# PRINTLAB_SESSION_COOKIE=""
# PRINTLAB_AUTH_HEADER=""
# Optional: shared secret expected on PrintLab callbacks into MakerWorks
# PRINTLAB_WEBHOOK_SECRET=""
# Legacy aliases still supported:
# BAMBU_VIEW_BASE_URL=""
# BAMBU_VIEW_API_KEY=""
# Optional: override StockWorks color hex values by name (JSON map).
# Example: {"Dark Brown":"#3b2f2f","Light Grey":"#d1d5db"}
# STOCKWORKS_COLOR_OVERRIDES=""
# Optional: warn about low inventory levels (grams).
# STOCKWORKS_LIMITED_THRESHOLD_GRAMS="1000"
# Optional: lead time when out of stock (days).
# STOCKWORKS_OUT_OF_STOCK_LEAD_DAYS="7"
# Optional: per-material lead times (JSON map in days).
# Example: {"PLA":3,"PETG":7}
# STOCKWORKS_MATERIAL_LEAD_DAYS=""
# Currency settings (USD, CAD, AUD or EUR). Server-side pricing, the order and Stripe use CURRENCY; the browser pages read NEXT_PUBLIC_CURRENCY,
# which is written into the pages WHEN THEY ARE BUILT (`npm run build`, or the Docker build argument of the same name): set BOTH to the same
# value, then rebuild after any change. The server refuses card payments while the build and CURRENCY disagree, and in production when
# CURRENCY is not set (docs/PROGETTO.md, "Cambio di valuta"). Switching currency does NOT convert any amount.
NEXT_PUBLIC_CURRENCY="EUR"
CURRENCY="EUR"
# Smallest card payment Stripe accepts, in cents (the TOTAL charged, shipping and tax included). Default 50 for USD, EUR, CAD and AUD; set it only if your
# Stripe account has another limit. It is NOT the shop's minimum order (that one is set by an administrator in Admin -> Site config, on the products only).
# STRIPE_MINIMUM_CHARGE_CENTS="50"
# Requests for a manual quote (cart that cannot be paid online) allowed per address and per customer in each rate-limit window (default 5).
# CHECKOUT_MANUAL_RATE_MAX="5"
# Tax on orders (docs/CHECKOUT-S2-S3.md). REQUIRED in production: online sales are refused until this is set.
#   TAX_MODE=none        no tax shown or added (explicit choice, e.g. a regime that does not charge VAT)
#   TAX_MODE=inclusive   listed prices already contain the tax (the tax part is recorded)
#   TAX_MODE=exclusive   the tax is added on top of the listed prices
# TAX_MODE=""
# TAX_RATE_PERCENT="22"
# Hosted card checkout (docs/CHECKOUT-S2-S3.md)
#   BASE_URL must be the public https:// address in production: Stripe sends the customer back there.
#   SHIPPING_FLAT_RATE_CENTS: the single shipping rate for Italy, in whole cents ("700" = 7.00; "0" = free on purpose).
#     Without it shipping is NOT offered (it is never free by omission).
#   HOSTED_CHECKOUT_ENABLED: production only; leave it off until the payment confirmation (webhook) and the customer pages are in place.
# SHIPPING_FLAT_RATE_CENTS=""
# HOSTED_CHECKOUT_ENABLED="false"
# The OLD card checkout (PaymentIntent confirmed by the browser) is kept only for migration and tests. In production it is OFF unless
# this is set to "true"; leave it off (it creates the order after payment and is removed in step 6 of S2/S3).
# LEGACY_CARD_CHECKOUT_ENABLED="false"
# The inbound OrderWorks webhook (POST /api/makerworks/jobs) is OFF in production unless this is "true". Leave it off unless an outside
# OrderWorks service really sends jobs: its payment claims are not verified, so the orders it creates always wait for an administrator.
# The secret below is also used by the PrintLab callbacks and the G-code upload and must stay set; it is accepted in a header only.
# ORDERWORKS_INBOUND_ENABLED="false"
# How long a payment update waits for another update of the SAME order before answering with a retryable error (milliseconds).
# PAYMENT_SYNC_MAX_WAIT_MS="8000"
# Client address for the request limits (login, registration, checkout). The app believes ONLY an address that a proxy of yours wrote
# (lib/client-ip.ts); X-Forwarded-For / X-Real-IP sent by a visitor are ignored. With neither setting below, every request counts as
# "unknown" (the checkout per-address limit then stands aside, login/registration limits are shared by all visitors) and the admin
# environment check reports it as an error in production. Set ONE of them:
#   TRUSTED_PROXY_HOPS   number of reverse proxies of yours in front of the app that append to X-Forwarded-For (1 = one proxy).
#                        The proxy must APPEND the address it sees (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for).
#   CLIENT_IP_HEADER     a header your platform always overwrites with the client address, one address only (cf-connecting-ip,
#                        fly-client-ip, or x-real-ip when the proxy sets it from $remote_addr). Takes precedence over the hops.
# Never point CLIENT_IP_HEADER at a header the visitor can reach the app with directly (app reachable without the proxy).
# TRUSTED_PROXY_HOPS="1"
# CLIENT_IP_HEADER=""
# Request limits for the checkout endpoints (per address / per user / whole shop, per window)
# CHECKOUT_SESSION_RATE_MAX="20"
# CHECKOUT_QUOTE_RATE_MAX="120"
# CHECKOUT_GLOBAL_RATE_MAX="300"
# CHECKOUT_RATE_WINDOW_SECONDS="600"
# Order status page (GET /api/checkout/status): its own budgets, per order / per address and for the whole shop, per window
# CHECKOUT_STATUS_RATE_MAX="240"
# CHECKOUT_STATUS_GLOBAL_RATE_MAX="3000"
NEXT_PUBLIC_CONTACT_EMAIL="info@example.com"
# Branding (set the display name/version to re-theme the UI)
NEXT_PUBLIC_BRAND_NAME="MakerWorks"
NEXT_PUBLIC_BRAND_VERSION="v2"
NEXT_PUBLIC_BRAND_LAB_NAME="MakerWorks lab"
NEXT_PUBLIC_BRAND_HANDLE="@makerworks"
# Optional legacy override. In-app suite setup is preferred.
# Email delivery (SMTP settings mirror the OrderWorks app defaults)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="receipts.makerworks@gmail.com"
# SMTP_PASSWORD=""
# SMTP_SECURE="false"
# RECEIPT_FROM_EMAIL="MakerWorks Receipts <receipts.makerworks@gmail.com>"
# RECEIPT_REPLY_TO_EMAIL="MakerWorks <info@makerworks.app>"
# Optional CAD-specific overrides when CURRENCY=CAD (fall back to USD values if unset)
# PLA_PRICE_PER_KG_CAD="30.00"
# PETG_PRICE_PER_KG_CAD="34.00"
# ENERGY_CAD_PER_HOUR="0"
# MACHINE_USD_PER_HOUR="0"
# MACHINE_CAD_PER_HOUR="0"
# LABOR_USD_PER_HOUR="0"
# LABOR_CAD_PER_HOUR="0"
# MINIMUM_PRICE_CAD="0"
# EXTRA_HOURLY_AFTER_FIRST_USD="0"
# EXTRA_HOURLY_AFTER_FIRST_CAD="0"
# Optional AUD-specific overrides when CURRENCY=AUD (fall back to USD values if unset)
# PLA_PRICE_PER_KG_AUD="38.00"
# PETG_PRICE_PER_KG_AUD="42.00"
# ENERGY_AUD_PER_HOUR="0"
# MACHINE_AUD_PER_HOUR="0"
# LABOR_AUD_PER_HOUR="0"
# MINIMUM_PRICE_AUD="0"
# EXTRA_HOURLY_AFTER_FIRST_AUD="0"
# Minimum-price waivers (step 4.6): Admin -> Price waivers lets an administrator sell ONE model or product under the shop's minimum, with a reason and an
# audit event. Optional second lock: a comma-separated list of administrator user ids; when set, ONLY those administrators can grant or revoke a waiver.
# PRICE_WAIVER_ADMIN_IDS=""
# Optional seasonal theming.
# Set to christmas, halloween, or easter to enable matching UI flourishes.
HOLIDAY_THEME=""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Admin"
# Optional: password for admin-created invite accounts (leave blank for random)
# ADMIN_INVITE_PASSWORD="change-me"
INVITE_LOGIN_TOKEN_TTL_HOURS="24"
# Auth rate limiting (seconds)
# AUTH_LOGIN_RATE_WINDOW_SECONDS="900"
# AUTH_LOGIN_RATE_MAX="5"
# AUTH_LOGIN_LOCK_SECONDS="900"
# AUTH_REGISTER_RATE_WINDOW_SECONDS="3600"
# AUTH_REGISTER_RATE_MAX="5"
# AUTH_REGISTER_LOCK_SECONDS="3600"
# AUTH_RESEND_RATE_WINDOW_SECONDS="3600"
# AUTH_RESEND_RATE_MAX="3"
# AUTH_RESEND_LOCK_SECONDS="3600"

# Data retention policy (days)
# DATA_RETENTION_UPLOAD_DAYS="90"
# DATA_RETENTION_LOG_DAYS="180"
# DATA_RETENTION_MESSAGE_DAYS="365"

# Web push (PWA offline notifications)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
