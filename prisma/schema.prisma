enum FulfillmentStatus {
  pending
  ready
  picked_up
  shipped
}

enum UserRole {
  admin
  staff
  customer
}

model PrintOrder {
  id              String   @id @default(cuid())
  orderNumber     Int      @default(autoincrement()) @unique
  userId          String?
  customerEmail   String?
  customerName    String?
  status          String   @default("awaiting_review")
  paymentMethod   String   @default("card")
  paymentStatus   String   @default("pending")
  stripePaymentIntentId String? @unique
  stripeChargeId  String?
  stripeCustomerId String?
  stripeInvoiceId String? @unique
  hostedInvoiceUrl String?
  invoicePdfUrl   String?
  refundedCents   Int      @default(0)
  // step 4.6, S6 (M3b): a counter that only goes UP. It is increased, in the SAME update, every time a fact the production release depends on changes (lib/financial-revision.ts
  // lists them: the payment, its proof, a refund, a dispute, the amounts, the cancellation...). An administrator's authorization records the value the order had when it was
  // given and is valid only while the order still has that value: whatever happens to the money afterwards - even a refund that fails or a total that is put back - an old
  // authorization does not come back to life; a new decision, with a reason, is needed. Not the file revisions of PrintOrderRevision, and never set to a value: only incremented.
  financialRevision Int    @default(0)
  receiptUrl      String?
  shippingMethod  String   @default("pickup")
  shippingAddress Json?
  subtotalCents   Int
  discountPercent Float?
  totalCents      Int
  currency        String   @default("USD")
  // totalCents is what the customer is asked to pay and is fixed when the order is created:
  // total = items (after discounts) + shippingCents + tax that is ADDED on top (see lib/tax.ts). taxCents is the tax amount
  // contained in or added to the total ("inclusive" prices: informational only, the total is unchanged).
  // Orders created before these columns existed have shippingCents = 0 even if shipping was charged (it is inside totalCents).
  shippingCents   Int      @default(0)
  taxCents        Int      @default(0)
  // Idempotency key of the checkout that created the order (one key = one order, however many times the request is repeated).
  checkoutKey     String?  @unique
  // Set once, when a payment has been verified with Stripe (amount, currency, order).
  paidAt          DateTime?
  // Why a human has to look at the payment (e.g. amount, currency, paid_after_cancel). Null = nothing to review.
  // While it is set the order is never released to production automatically.
  paymentReviewReason String?
  // Only ONE read-from-Stripe-and-apply cycle per order at a time (lib/payment-sync.ts): the cycle takes this lease first, reads
  // Stripe WITHOUT holding a database transaction, then applies what it read and clears the lease. Because two cycles for the same
  // order never overlap, a state read earlier can never be applied after one read later. A lease that is not cleared (crash)
  // simply expires. paymentSyncedAt = when the state now stored was read from Stripe.
  paymentSyncLeaseId String?
  paymentSyncLeaseUntil DateTime?
  paymentSyncedAt DateTime?
  // Guest orders: SHA-256 of the random access token handed to the buyer, and when it stops working. Never the token itself.
  guestAccessTokenHash String?
  guestAccessExpiresAt DateTime?
  // Guest orders: SHA-256 of the guest's browser session (lib/guest-session.ts), never the session itself. It ties the repeat-key and the "same purchase" check
  // to ONE browser and opens nothing. Emptied by the retention job when it is of no use any more (lib/data-retention.ts). Null for orders of accounts and for
  // orders made before it existed.
  guestSessionHash String?
  contributionType String   @default("paid")
  donatedAmountCents Int?
  materialCostCents Int?
  machineTimeMinutes Int?
  receiptStatus   String   @default("none")
  contributionNotes String?
  notes           String?
  metadata        Json?
  printerId       String?
  printerAssignedAt DateTime?
  printerAssignedBy String?
  failedAt        DateTime?
  failureNote     String?
  reprintOfId     String?
  organizationId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  printer   Printer?     @relation(fields: [printerId], references: [id], onDelete: SetNull)
  items     PrintOrderItem[]
  revisions PrintOrderRevision[]
  messages PrintOrderMessage[]
  approvalRequests PrintOrderApprovalRequest[]
  reprintOf PrintOrder?   @relation("ReprintSource", fields: [reprintOfId], references: [id])
  reprints  PrintOrder[]  @relation("ReprintSource")
  failurePhotos FailurePhoto[]
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  paymentAttempts PaymentAttempt[]
  // step 4.6, S6 (M3a): the refunds requested from the application, one row per intention of an administrator. While one is open the order is NOT released to production
  // (lib/order-payment-policy.ts, `refundOperationBlocks`). An order with refund operations can not be deleted (onDelete: Restrict on the other side).
  refundOperations RefundOperation[]
  // step 4.6, R1-1b: the checkout keys of the guest's browser that were shown to belong to THIS order (see GuestPurchaseKey). They follow the order: they go with it.
  guestPurchaseKeys GuestPurchaseKey[]

  @@index([organizationId])
  @@index([contributionType])
  @@index([receiptStatus])
  @@index([stripeCustomerId])
  @@index([paymentStatus])
  @@index([paymentReviewReason])
  @@index([guestSessionHash])
}

// step 4.6, R1-1b (docs/SESSIONE-OSPITE.md, R1): the guard against a second guest order for the same purchase. A guest's browser chooses a checkout key K and sends it with every
// attempt; the first time the server shows that K belongs to an order, it writes ONE row here - the FINGERPRINT of K (SHA-256 of "mw:purchase-key:v1:" + K, lib/purchase-intent.ts;
// K itself is never stored: the CHECK of the migration lets nothing but 64 hex digits in) and that order - and from then on K can not make another order, for any session, in any
// process: the primary key is the arbiter. A row is written once and never changed or moved (the code only creates and reads; the order's deletion removes it). K correlates, it
// never authorises: whose order it is is shown by the session, the account or the order's own access cookie. `PrintOrder.checkoutKey` keeps the meaning it had.
// ROLLBACK: the table is not dropped while it holds a binding; the application is rolled back by suspending the checkout (docs/RILASCIO-PRODUZIONE.md, "R1-1b").
model GuestPurchaseKey {
  keyHash   String   @id
  orderId   String
  createdAt DateTime @default(now())

  order PrintOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// One row per Stripe Checkout Session opened for an order (an order can have several: retries after an expired or abandoned
// session). The amount and currency are a frozen copy of what Stripe was asked to collect; a payment is accepted only if what
// Stripe reports matches this row AND the order.
//
// The row is written BEFORE Stripe is called (status "creating", no session id yet) and completed afterwards. Stripe is asked to
// create the session with the row id as idempotency key, so if the server dies after Stripe created the session but before the
// answer was saved, the retry finds the same row, asks Stripe again with the same key and gets the SAME session back.
model PaymentAttempt {
  id                    String    @id @default(cuid())
  orderId               String
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?   @unique
  amountCents           Int
  currency              String
  // creating | open | processing | paid | expired | failed | mismatch
  status                String    @default("creating")
  amountReceivedCents   Int?
  expiresAt             DateTime
  completedAt           DateTime?
  failureReason         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order PrintOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, expiresAt])
}

// step 4.6, S6 (M3a): one row per refund an administrator asks the application to make. The row is written BEFORE Stripe is called (status "requested"), and from that
// moment the order is not released to production; it stays so until the refund is over and its final state has been read back from Stripe and applied (`appliedAt`).
// The id is the `operationId` the administrator's form made once: the Stripe idempotency key is derived from it and from nothing else.
//
// status: requested | sending | unknown | pending | requires_action | succeeded | failed | canceled | abandoned | unresolved
//   * "abandoned" means ONE thing: it is PROVEN that nothing was ever sent (`firstSentAt` is written, and confirmed, BEFORE the first call to Stripe). The migration adds a
//     CHECK constraint that makes it impossible to store "abandoned" with a `firstSentAt`.
//   * "unresolved": the request may have been sent and can not be found again. It blocks production and new refunds for the order; the only way out in the application is to
//     ADOPT a refund that carries this operation's own metadata. Absence in a list of refunds is never taken as proof that nothing happened.
// Never deleted from the application: it is the record of money that was asked to move.
model RefundOperation {
  id                    String    @id
  orderId               String
  paymentIntentId       String
  amountCents           Int
  currency              String
  // what the order's refunded amount was when the administrator decided (a refund is only valid for the state it was decided on)
  expectedRefundedCents Int
  reason                String
  note                  String
  status                String
  stripeRefundId        String?   @unique
  // the last state OBSERVED on the Stripe refund object (pending | requires_action | succeeded | failed | canceled)
  stripeRefundStatus    String?
  // api_rejected | refund_failed | refund_canceled
  failureKind           String?
  failureCode           String?
  adminId               String?
  attempts              Int       @default(0)
  sendLeaseUntil        DateTime?
  // written BEFORE the first call: empty = proof that nothing was ever sent
  firstSentAt           DateTime?
  // the API returned a Refund object (NOT: the money moved)
  acceptedAt            DateTime?
  // the final state read back from Stripe after the outcome was applied to the order (or to the payment attempt, for a duplicate)
  appliedAt             DateTime?
  lastReconciledAt      DateTime?
  // the last reconciliation: ids, states and amounts of the refunds seen on the payment, expected and observed refunded amount (no personal data)
  lastObservation       Json?
  unresolvedAt          DateTime?
  // window_expired_not_found | list_inconclusive | idempotency_unverified
  unresolvedReason      String?
  // reconcile | admin_adopt
  recoveredBy           String?
  adoptedBy             String?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order PrintOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
}

model StripeEvent {
  id              String   @id
  type            String
  paymentIntentId String?
  // Filled when the event was applied to an order. A processed payment event with orderId = null is a payment we could not
  // match to any order: it is listed by the reconciliation script.
  checkoutSessionId String?
  orderId         String?
  payload         Json?
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([paymentIntentId])
  @@index([checkoutSessionId])
  @@index([orderId])
}

model Organization {
  id                       String   @id @default(cuid())
  name                     String
  slug                     String   @unique
  category                 String   @default("customer")
  charitableRegistrationNumber String?
  communityNotes           String?
  billingEmail             String?
  billingContact           String?
  quoteApprovalRequired    Boolean  @default(true)
  requirePoAboveCents      Int?
  procurementConfig        Json?
  createdById              String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  createdBy User @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  members OrganizationMember[]
  orders  PrintOrder[]

  @@index([createdById])
  @@index([category])
  @@index([name])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("requester")
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

