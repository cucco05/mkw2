  sizeBytes    Int?
  width        Int?
  height       Int?
  orderId      String?
  printerId    String?
  modelId      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  order      PrintOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  printer    Printer?    @relation(fields: [printerId], references: [id], onDelete: SetNull)
  model      Model?      @relation(fields: [modelId], references: [id], onDelete: SetNull)
  uploadedBy User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([label])
  @@index([createdAt])
  @@index([orderId])
  @@index([printerId])
  @@index([modelId])
}

