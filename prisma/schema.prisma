model MerchNotifyRequest {
  id          String    @id @default(cuid())
  merchItemId String
  email       String
  name        String?
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  merchItem MerchItem @relation(fields: [merchItemId], references: [id], onDelete: Cascade)

