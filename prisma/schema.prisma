  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PricingProfile {
  id          String   @id @default(cuid())
  name        String
  description String?
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Printer {
  id                 String   @id @default(cuid())
  name               String
  provider           String   @default("local")
  externalId         String?
  status             String   @default("available")
  active             Boolean  @default(true)
  dailyCapacityHours Float    @default(8)
  notes              String?
  lastMaintenanceAt  DateTime?
  maintenanceIntervalHours Float?
  maintenanceNotes   String?
  metadata           Json?
  lastSeenAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders             PrintOrder[]
  failurePhotos      FailurePhoto[]

  @@index([status])
  @@index([active])
}

// What a machine can make: its build volume, the technical margins, the materials and finishes it can be given. The server reads these rows
// before an order is accepted for automatic payment (lib/printability.ts); a model or an option no ACTIVE machine can make goes to a person
// for manual review instead. Adding a machine = adding a row (Admin -> Printer machines or /api/admin/printer-machines); no code changes.
// Not the same thing as Printer above, which is a physical device of the workshop (status, capacity, maintenance).
model PrinterMachine {
  id               String   @id @default(cuid())
  key              String   @unique
  label            String
  isActive         Boolean  @default(true)
  // Nominal build volume in millimetres (what the manufacturer states).
  buildXmm         Float
  buildYmm         Float
  buildZmm         Float
  // Technical margins kept free: on EACH side of the plate in X and Y (skirt/brim, purge line, edge of the bed) and at the top in Z.
  marginXYmm       Float    @default(3)
  marginZmm        Float    @default(2)
  // Extra margin on each side in X and Y when the model may need supports (or it is not known whether it does).
  supportMarginXYmm Float   @default(3)
  nozzleDiameterMm Float    @default(0.4)
  // The thinnest extent (any axis, after scaling) the machine is trusted to print; null = the nozzle diameter.
  minFeatureMm     Float?
  // Above this share of supports (0..1) a person has to look at the model; null = no limit.
  maxSupportRatio  Float?
  // Upper-case material names (PLA, PETG, ...) and lower-case finishes (standard, matte, ...) this machine can make.
  allowedMaterials String[]
  allowedFinishes  String[]
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
}

// Step 4.6 (S3): an AUTHORISED, TRACED exception to the shop's minimum price per unit, for ONE model or ONE ready-made product (the catalogue level: the only
// place where the server prices the customer's cart on its own - a hand-set price under the minimum, a product the shop sells for less).
// Written only by an administrator (Admin -> Minimum price waivers), together with an audit event. Read by the price engine when it prices a cart and
// NEVER by any customer request. Not retroactive: an order keeps the price it was made with. A waiver changes ONLY the threshold used in the price:
// it does not mark anything paid, does not authorise production and does not touch a payment under review. No foreign keys on purpose: the row (and
// who granted it, and why) must outlive the model or product it was about.
model MinimumPriceWaiver {
  id                String    @id @default(cuid())
  // exactly one of the two targets
  modelId           String?
  productTemplateId String?
  // the least ONE unit may cost with the waiver, in whole cents (0 <= value < the shop's minimum when granted)
  minimumPriceCents Int
  reason            String
  createdById       String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime?
  revokedAt         DateTime?
  revokedById       String?
  revokeReason      String?

  @@index([modelId])
  @@index([productTemplateId])
  @@index([revokedAt])
}

